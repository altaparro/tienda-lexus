---
import Layout from '../../layouts/Layout.astro'
import BotonCarrito from '../../components/BotonCarrito'
import GaleriaProducto from '../../components/GaleriaProducto'
import TarjetasRelacionadas from '../../components/TarjetasRelacionadas'
import { obtenerProductoPublico, obtenerProductosPublicos } from '../../lib/productos'
import { fmtPrecio } from '../../lib/format'
import { NEGOCIO, linkWhatsApp } from '../../lib/negocio'

const { id } = Astro.params
const producto = await obtenerProductoPublico(id)

if (!producto) {
  return new Response(
    '<!doctype html><html lang="es"><body style="font-family:sans-serif;padding:4rem;text-align:center"><h1>Producto no encontrado</h1><p><a href="/catalogo">Volver al catálogo</a></p></body></html>',
    { status: 404, headers: { 'Content-Type': 'text/html; charset=utf-8' } }
  )
}

const galeria = producto.imagenes?.length
  ? producto.imagenes
  : producto.imagen
    ? [producto.imagen]
    : []

const relacionados = (await obtenerProductosPublicos())
  .filter((p) => p.id !== producto.id && p.tipo?.id === producto.tipo?.id)
  .slice(0, 4)

const stock = Number(producto.stock || 0)
const consulta = linkWhatsApp(
  `Hola ${NEGOCIO.nombre}, quiero consultar por: ${producto.marca ? `${producto.marca} ` : ''}${producto.nombre}`
)
---

<Layout
  title={`${producto.marca ? `${producto.marca} ` : ''}${producto.nombre} — Lexus Autoradio`}
  description={producto.descripcion || `Comprá ${producto.nombre}${producto.marca ? ` ${producto.marca}` : ''} en Lexus Autoradio. Precio: ${fmtPrecio.format(producto.precio_venta)}.`}
>
  <div class="mx-auto max-w-6xl px-4 py-10">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: `${producto.marca ? `${producto.marca} ` : ''}${producto.nombre}`,
      sku: producto.codigo,
      brand: producto.marca ? { '@type': 'Brand', name: producto.marca } : undefined,
      description: producto.descripcion || undefined,
      image: galeria.length ? galeria : undefined,
      offers: {
        '@type': 'Offer',
        price: producto.precio_venta,
        priceCurrency: 'ARS',
        availability: stock > 0
          ? 'https://schema.org/InStock'
          : 'https://schema.org/OutOfStock'
      }
    })} />

    <nav class="mb-6 text-sm text-neutral-400">
      <a href="/" class="transition hover:text-neutral-200">Inicio</a>
      <span class="mx-2">/</span>
      <a href="/catalogo" class="transition hover:text-neutral-200">Catálogo</a>
      <span class="mx-2">/</span>
      <span class="text-neutral-400">{producto.nombre}</span>
    </nav>

    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        {
          galeria.length > 0 ? (
            <GaleriaProducto client:load imagenes={galeria} nombre={producto.nombre} />
          ) : (
            <div class="flex aspect-square w-full items-center justify-center overflow-hidden rounded-3xl border border-neutral-700 bg-white">
              <svg class="h-20 w-20 text-neutral-200" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
              </svg>
            </div>
          )
        }
      </div>

      <div>
        {
          producto.marca && (
            <p class="text-xs font-semibold uppercase tracking-widest text-orange-400">
              {producto.marca}
            </p>
          )
        }
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-neutral-100">{producto.nombre}</h1>

        {
          producto.descripcion && (
            <p class="mt-4 whitespace-pre-line text-sm leading-relaxed text-neutral-400">
              {producto.descripcion}
            </p>
          )
        }

        <p class="mt-4 text-3xl font-bold tabular-nums text-neutral-100">
          {fmtPrecio.format(producto.precio_venta)}
        </p>

        <div class="mt-4 flex flex-wrap items-center gap-3 text-sm">
          {
            stock > 0 ? (
              <span
                class={`rounded-full px-3 py-1 font-medium ring-1 ${
                  stock <= 5
                    ? 'bg-amber-500/10 text-amber-400 ring-amber-500/20'
                    : 'bg-emerald-500/10 text-emerald-400 ring-emerald-500/20'
                }`}
              >
                {stock <= 5 ? `¡Solo ${stock} en stock!` : 'En stock'}
              </span>
            ) : (
              <span class="rounded-full bg-red-500/10 px-3 py-1 font-medium text-red-400 ring-1 ring-red-500/20">
                Sin stock
              </span>
            )
          }
          {producto.tipo?.nombre && (
            <span class="rounded-full bg-neutral-800 px-3 py-1 font-medium text-neutral-400 ring-1 ring-neutral-700">
              {producto.tipo.nombre}
            </span>
          )}
          <span class="text-neutral-400">Cód. {producto.codigo}</span>
        </div>

        <div class="mt-8 max-w-xs">
          <BotonCarrito client:load producto={producto} />
        </div>

        <a
          href={consulta}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 block max-w-xs rounded-xl border border-neutral-700 bg-neutral-800 px-6 py-3.5 text-center text-sm font-semibold text-neutral-300 transition hover:border-neutral-600 hover:bg-neutral-700"
        >
          Consultar por WhatsApp
        </a>

        <div class="mt-8 space-y-3 rounded-2xl border border-neutral-700 bg-neutral-800 p-5 text-sm text-neutral-400">
          <p class="flex items-start gap-3">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-orange-500" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />
            </svg>
            <span>Retiro gratis en {NEGOCIO.ciudad} · Envíos a coordinar por WhatsApp.</span>
          </p>
          <p class="flex items-start gap-3">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-orange-500" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />
            </svg>
            <span>El pedido se confirma por WhatsApp: sin pagos online.</span>
          </p>
          <p class="flex items-start gap-3">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-orange-500" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
            <span>{NEGOCIO.horarios}</span>
          </p>
        </div>
      </div>
    </div>

    {
      relacionados.length > 0 && (
        <section class="mt-16">
          <h2 class="mb-6 text-xl font-bold tracking-tight text-neutral-100">
            Productos relacionados
          </h2>
          <TarjetasRelacionadas client:load productos={relacionados} />
        </section>
      )
    }
  </div>
</Layout>
