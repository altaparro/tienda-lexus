---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/Hero'
import ListadoProductos from '../components/ListadoProductos'
import { obtenerProductosPublicos } from '../lib/productos'
import { NEGOCIO } from '../lib/negocio'

const productos = await obtenerProductosPublicos()

const heroGlob = import.meta.glob('/src/assets/hero/*.{jpg,jpeg,png,webp}', {
  eager: true,
  query: '?url',
  import: 'default'
})
const imagenesHero = Object.keys(heroGlob)
  .sort()
  .map((k) => heroGlob[k])

const normalizar = (t) =>
  (t || '')
    .toLowerCase()
    .normalize('NFD')
    .replace(/\p{Diacritic}/gu, '')

const esEstereo = (p) => normalizar(p.tipo?.nombre).includes('estereo')

const productosOrdenados = [...productos].sort(
  (a, b) => Number(esEstereo(b)) - Number(esEstereo(a))
)

const categorias = Object.entries(
  productos.reduce((acc, p) => {
    const nombre = p.tipo?.nombre || 'Otros'
    acc[nombre] = (acc[nombre] || 0) + 1
    return acc
  }, {})
).sort((a, b) => b[1] - a[1])

const textoHero =
  'Somos una empresa familiar desde 2006. Nos dedicamos a la venta e instalación de estéreos multimedias, parlantes, alarmas, cierres centralizados, iluminación, Cree LEDs y electricidad en general.'

const servicios = [
  ['🔊', 'Estéreos multimedias'],
  ['🎤', 'Parlantes'],
  ['🚨', 'Alarmas'],
  ['🔑', 'Cierres centralizados'],
  ['💡', 'Iluminación y Cree LEDs'],
  ['⚡', 'Electricidad en general']
]
---

<Layout>
  <Hero client:load imagenes={imagenesHero} />

  <div class="mx-auto max-w-6xl px-4 py-6">
    <ul class="grid grid-cols-1 gap-3 sm:grid-cols-3">
      <li class="flex items-center gap-3 rounded-xl border border-slate-700 bg-neutral-800 px-5 py-4 transition hover:border-orange-500/40">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-orange-500/10 text-orange-500">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" strokeWidth={1.8} stroke="currentColor">
            <path strokeLinecap="round" strokeLinejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 1-3 0m3 0H19.5m-14.25 0H5.25m14.25 0a1.5 1.5 0 0 0 3 0m-3 0h-3m-12 0a9 9 0 1 1 18 0" />
          </svg>
        </span>
        <div>
          <p class="text-sm font-semibold text-slate-100">Envíos a coordinar</p>
          <p class="text-xs text-slate-400">Te lo llevamos o lo retirás</p>
        </div>
      </li>
      <li class="flex items-center gap-3 rounded-xl border border-slate-700 bg-neutral-800 px-5 py-4 transition hover:border-orange-500/40">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-orange-500/10 text-orange-500">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" strokeWidth={1.8} stroke="currentColor">
            <path strokeLinecap="round" strokeLinejoin="round" d="M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 0 0 3.75-.615M3.75 9.35l5.14-5.592a2.25 2.25 0 0 1 3.22 0l5.14 5.592m-13.5 0a3.001 3.001 0 0 0 3.75.615" />
          </svg>
        </span>
        <div>
          <p class="text-sm font-semibold text-slate-100">Retiro en {NEGOCIO.ciudad}</p>
          <p class="text-xs text-slate-400">Atención personalizada</p>
        </div>
      </li>
      <li class="flex items-center gap-3 rounded-xl border border-slate-700 bg-neutral-800 px-5 py-4 transition hover:border-orange-500/40">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-orange-500/10 text-orange-500">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" strokeWidth={1.8} stroke="currentColor">
            <path strokeLinecap="round" strokeLinejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />
          </svg>
        </span>
        <div>
          <p class="text-sm font-semibold text-slate-100">Confirmación por WhatsApp</p>
          <p class="text-xs text-slate-400">Coordinamos stock y entrega</p>
        </div>
      </li>
    </ul>
  </div>

  <!-- Productos -->
  {
    productos.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-8">
        <div class="mb-6 flex items-end justify-between">
          <div>
            <h2 class="text-xl font-bold tracking-tight text-slate-100">Productos</h2>
            <p class="mt-1 text-sm text-slate-400">
              Empezamos por los estéreos. Usá el catálogo para buscar el resto.
            </p>
          </div>
          <a
            href="/catalogo"
            class="text-sm font-medium text-orange-600 transition hover:text-orange-700"
          >
            Ver todos →
          </a>
        </div>
        <ListadoProductos client:load productos={productosOrdenados} />
      </section>
    )
  }

  <!-- Categorías -->
  {
    categorias.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-8">
        <h2 class="mb-6 text-xl font-bold tracking-tight text-slate-100">Categorías</h2>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
          {categorias.map(([nombre, cantidad]) => (
            <a
              href={`/catalogo?tipo=${encodeURIComponent(nombre)}`}
              class="rounded-2xl border border-slate-700 bg-neutral-800 p-4 text-center shadow-sm transition hover:-translate-y-0.5 hover:border-orange-500/60 hover:shadow-md"
            >
              <p class="text-sm font-semibold text-slate-200">{nombre}</p>
              <p class="mt-1 text-xs text-slate-400">
                {cantidad} {cantidad === 1 ? 'producto' : 'productos'}
              </p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- Quiénes somos y servicios -->
  <section class="border-t border-slate-700 bg-neutral-800">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <h1 class="text-xl font-bold tracking-tight text-slate-100">Quiénes somos y servicios</h1>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-slate-400">{textoHero}</p>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-400">
        Comprá online desde donde estés y coordiná todo por WhatsApp, o acercate al local y te
        atendemos personalmente. {NEGOCIO.direccion} · {NEGOCIO.horarios}
      </p>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          servicios.map(([icono, nombre]) => (
            <div class="rounded-2xl border border-slate-700 bg-neutral-800 p-4">
              <span class="text-lg">{icono}</span>
              <h3 class="mt-2 text-sm font-semibold text-slate-200">{nombre}</h3>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Cómo funciona -->
  <section class="border-t border-slate-700 bg-neutral-800">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <h2 class="text-xl font-bold tracking-tight text-slate-100">Cómo comprar</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-3">
        <div class="rounded-2xl border border-slate-700 p-5">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-orange-100 text-sm font-bold text-orange-600">1</span>
          <h3 class="mt-3 text-sm font-semibold text-slate-200">Elegí tus productos</h3>
          <p class="mt-1 text-sm leading-relaxed text-slate-400">
            Sumá lo que necesites al carrito desde el catálogo.
          </p>
        </div>
        <div class="rounded-2xl border border-slate-700 p-5">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-orange-100 text-sm font-bold text-orange-600">2</span>
          <h3 class="mt-3 text-sm font-semibold text-slate-200">Dejá tus datos</h3>
          <p class="mt-1 text-sm leading-relaxed text-slate-400">
            Registrás el pedido en un minuto, sin pagos online.
          </p>
        </div>
        <div class="rounded-2xl border border-slate-700 p-5">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-orange-100 text-sm font-bold text-orange-600">3</span>
          <h3 class="mt-3 text-sm font-semibold text-slate-200">Lo confirmamos por WhatsApp</h3>
          <p class="mt-1 text-sm leading-relaxed text-slate-400">
            Coordinamos stock, pago y entrega con vos.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
