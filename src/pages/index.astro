---
import Layout from '../layouts/Layout.astro'
import TarjetaProducto from '../components/TarjetaProducto'
import { obtenerProductosPublicos } from '../lib/productos'
import { NEGOCIO, linkWhatsApp } from '../lib/negocio'

const productos = await obtenerProductosPublicos()

const novedades = [...productos].slice(-8).reverse()

const categorias = Object.entries(
  productos.reduce((acc, p) => {
    const nombre = p.tipo?.nombre || 'Otros'
    acc[nombre] = (acc[nombre] || 0) + 1
    return acc
  }, {})
).sort((a, b) => b[1] - a[1])

const waConsulta = linkWhatsApp(`Hola ${NEGOCIO.nombre}, quiero hacer una consulta.`)
---

<Layout>
  <!-- Hero -->
  <section class="border-b border-slate-200 bg-gradient-to-b from-orange-50 to-white">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center sm:py-20">
      <p class="text-xs font-semibold uppercase tracking-widest text-orange-600">
        Audio automotor · La Plata
      </p>
      <h1 class="mx-auto mt-3 max-w-2xl text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
        {NEGOCIO.nombre}
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-slate-500">
        Elegí tus productos, armá tu pedido online y lo confirmamos con vos por WhatsApp.
        Retiro en {NEGOCIO.ciudad} o envío a coordinar.
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <a
          href="/catalogo"
          class="rounded-xl bg-orange-600 px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-orange-700"
        >
          Ver catálogo
        </a>
        <a
          href={waConsulta}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-xl border border-slate-200 bg-white px-6 py-3.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
        >
          Consultar por WhatsApp
        </a>
      </div>

      <ul class="mx-auto mt-10 grid max-w-3xl grid-cols-1 gap-3 sm:grid-cols-3">
        <li class="flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-600 shadow-sm">
          🚚 Envíos a coordinar
        </li>
        <li class="flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-600 shadow-sm">
          🏪 Retiro en {NEGOCIO.ciudad}
        </li>
        <li class="flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-600 shadow-sm">
          💬 Confirmación por WhatsApp
        </li>
      </ul>
    </div>
  </section>

  <!-- Novedades -->
  {
    novedades.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-12">
        <div class="mb-6 flex items-end justify-between">
          <div>
            <h2 class="text-xl font-bold tracking-tight text-slate-900">Novedades</h2>
            <p class="mt-1 text-sm text-slate-500">Lo último que cargamos al catálogo</p>
          </div>
          <a
            href="/catalogo"
            class="text-sm font-medium text-orange-600 transition hover:text-orange-700"
          >
            Ver todos →
          </a>
        </div>
        <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
          {novedades.map((p) => (
            <TarjetaProducto producto={p} />
          ))}
        </div>
      </section>
    )
  }

  <!-- Categorías -->
  {
    categorias.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 pb-12">
        <h2 class="mb-6 text-xl font-bold tracking-tight text-slate-900">Categorías</h2>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
          {categorias.map(([nombre, cantidad]) => (
            <a
              href={`/catalogo?tipo=${encodeURIComponent(nombre)}`}
              class="rounded-2xl border border-slate-200 bg-white p-4 text-center shadow-sm transition hover:-translate-y-0.5 hover:border-orange-200 hover:shadow-md"
            >
              <p class="text-sm font-semibold text-slate-800">{nombre}</p>
              <p class="mt-1 text-xs text-slate-400">
                {cantidad} {cantidad === 1 ? 'producto' : 'productos'}
              </p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- Quiénes somos y servicios -->
  <section class="border-t border-slate-200 bg-white">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 lg:grid-cols-2">
      <div>
        <h2 class="text-xl font-bold tracking-tight text-slate-900">Quiénes somos</h2>
        <p class="mt-4 text-sm leading-relaxed text-slate-600">
          Somos {NEGOCIO.nombre}, un negocio de audio automotor en {NEGOCIO.ciudad}. Te
          asesoramos para encontrar el equipo ideal para tu vehículo, desde la primera consulta
          hasta la entrega.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">
          Comprá online desde donde estés y coordiná todo por WhatsApp, o acercate al local y te
          atendemos personalmente.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-slate-500">
          {NEGOCIO.direccion} · {NEGOCIO.horarios}
        </p>
      </div>

      <div>
        <h2 class="text-xl font-bold tracking-tight text-slate-900">Nuestros servicios</h2>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
            <span class="text-lg">🎯</span>
            <h3 class="mt-2 text-sm font-semibold text-slate-800">Asesoramiento</h3>
            <p class="mt-1 text-xs leading-relaxed text-slate-500">
              Te ayudamos a elegir el equipo según tu vehículo y tu presupuesto.
            </p>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
            <span class="text-lg">📦</span>
            <h3 class="mt-2 text-sm font-semibold text-slate-800">Envíos</h3>
            <p class="mt-1 text-xs leading-relaxed text-slate-500">
              Coordinamos el envío por WhatsApp a donde lo necesites.
            </p>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
            <span class="text-lg">🏪</span>
            <h3 class="mt-2 text-sm font-semibold text-slate-800">Retiro en el local</h3>
            <p class="mt-1 text-xs leading-relaxed text-slate-500">
              {NEGOCIO.horarios}
            </p>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
            <span class="text-lg">💬</span>
            <h3 class="mt-2 text-sm font-semibold text-slate-800">Atención por WhatsApp</h3>
            <p class="mt-1 text-xs leading-relaxed text-slate-500">
              Consultas y pedidos al {NEGOCIO.telefono}.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cómo funciona -->
  <section class="border-t border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <h2 class="text-xl font-bold tracking-tight text-slate-900">Cómo comprar</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 p-5">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-orange-100 text-sm font-bold text-orange-600">1</span>
          <h3 class="mt-3 text-sm font-semibold text-slate-800">Elegí tus productos</h3>
          <p class="mt-1 text-sm leading-relaxed text-slate-500">
            Sumá lo que necesites al carrito desde el catálogo.
          </p>
        </div>
        <div class="rounded-2xl border border-slate-200 p-5">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-orange-100 text-sm font-bold text-orange-600">2</span>
          <h3 class="mt-3 text-sm font-semibold text-slate-800">Dejá tus datos</h3>
          <p class="mt-1 text-sm leading-relaxed text-slate-500">
            Registrás el pedido en un minuto, sin pagos online.
          </p>
        </div>
        <div class="rounded-2xl border border-slate-200 p-5">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-orange-100 text-sm font-bold text-orange-600">3</span>
          <h3 class="mt-3 text-sm font-semibold text-slate-800">Lo confirmamos por WhatsApp</h3>
          <p class="mt-1 text-sm leading-relaxed text-slate-500">
            Coordinamos stock, pago y entrega con vos.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
