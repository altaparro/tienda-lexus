---
import Layout from '../layouts/Layout.astro'
import TarjetaProducto from '../components/TarjetaProducto'
import { obtenerProductosPublicos } from '../lib/productos'
import { NEGOCIO, linkWhatsApp } from '../lib/negocio'
import { fmtPrecio } from '../lib/format'

const productos = await obtenerProductosPublicos()

const novedades = [...productos].slice(-8).reverse()
const heroProductos = productos
  .filter((p) => p.imagen)
  .slice(-3)
  .reverse()

const categorias = Object.entries(
  productos.reduce((acc, p) => {
    const nombre = p.tipo?.nombre || 'Otros'
    acc[nombre] = (acc[nombre] || 0) + 1
    return acc
  }, {})
).sort((a, b) => b[1] - a[1])

const waConsulta = linkWhatsApp(`Hola ${NEGOCIO.nombre}, quiero hacer una consulta.`)
---

<Layout>
  <!-- Hero -->
  <section class="border-b border-slate-800 bg-slate-900">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 sm:py-20 lg:grid-cols-2">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-amber-400">
          Audio automotor · La Plata
        </p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-white sm:text-5xl">
          {NEGOCIO.nombre}
        </h1>
        <p class="mt-4 max-w-md text-base leading-relaxed text-slate-300">
          Elegí tus productos, armá tu pedido online y lo confirmamos con vos por WhatsApp.
          Retiro en {NEGOCIO.ciudad} o envío a coordinar.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href="/catalogo"
            class="rounded-xl bg-amber-500 px-6 py-3.5 text-sm font-semibold text-slate-900 shadow-sm transition hover:bg-amber-400"
          >
            Ver catálogo
          </a>
          <a
            href={waConsulta}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-xl border border-slate-700 bg-slate-800 px-6 py-3.5 text-sm font-semibold text-slate-200 transition hover:bg-slate-700"
          >
            Consultar por WhatsApp
          </a>
        </div>
      </div>

      {
        heroProductos.length > 0 && (
          <div class="grid grid-cols-3 gap-3 sm:gap-4">
            {heroProductos.map((p) => (
              <a
                href={`/producto/${p.id}`}
                class="group block overflow-hidden rounded-2xl bg-white shadow-lg transition hover:-translate-y-1 hover:shadow-xl"
              >
                <div class="aspect-square overflow-hidden bg-slate-50">
                  <img
                    src={p.imagen}
                    alt={p.nombre}
                    loading="lazy"
                    class="h-full w-full object-contain p-3 transition group-hover:scale-105"
                  />
                </div>
                <div class="p-3">
                  <p class="truncate text-xs font-semibold text-slate-800">{p.nombre}</p>
                  <p class="mt-1 text-sm font-bold tabular-nums text-slate-900">
                    {fmtPrecio.format(p.precio_venta)}
                  </p>
                </div>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <!-- Novedades -->
  {
    novedades.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-12">
        <div class="mb-6 flex items-end justify-between">
          <div>
            <h2 class="text-xl font-bold tracking-tight text-slate-900">Novedades</h2>
            <p class="mt-1 text-sm text-slate-500">Lo último que cargamos al catálogo</p>
          </div>
          <a
            href="/catalogo"
            class="text-sm font-medium text-orange-600 transition hover:text-orange-700"
          >
            Ver todos →
          </a>
        </div>
        <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
          {novedades.map((p) => (
            <TarjetaProducto producto={p} />
          ))}
        </div>
      </section>
    )
  }

  <!-- Categorías -->
  {
    categorias.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 pb-12">
        <h2 class="mb-6 text-xl font-bold tracking-tight text-slate-900">Categorías</h2>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
          {categorias.map(([nombre, cantidad]) => (
            <a
              href={`/catalogo?tipo=${encodeURIComponent(nombre)}`}
              class="rounded-2xl border border-slate-200 bg-white p-4 text-center shadow-sm transition hover:-translate-y-0.5 hover:border-orange-200 hover:shadow-md"
            >
              <p class="text-sm font-semibold text-slate-800">{nombre}</p>
              <p class="mt-1 text-xs text-slate-400">
                {cantidad} {cantidad === 1 ? 'producto' : 'productos'}
              </p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- Cómo funciona -->
  <section class="border-t border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <h2 class="text-xl font-bold tracking-tight text-slate-900">Cómo comprar</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 p-5">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-orange-100 text-sm font-bold text-orange-600">1</span>
          <h3 class="mt-3 text-sm font-semibold text-slate-800">Elegí tus productos</h3>
          <p class="mt-1 text-sm leading-relaxed text-slate-500">
            Sumá lo que necesites al carrito desde el catálogo.
          </p>
        </div>
        <div class="rounded-2xl border border-slate-200 p-5">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-orange-100 text-sm font-bold text-orange-600">2</span>
          <h3 class="mt-3 text-sm font-semibold text-slate-800">Dejá tus datos</h3>
          <p class="mt-1 text-sm leading-relaxed text-slate-500">
            Registrás el pedido en un minuto, sin pagos online.
          </p>
        </div>
        <div class="rounded-2xl border border-slate-200 p-5">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-orange-100 text-sm font-bold text-orange-600">3</span>
          <h3 class="mt-3 text-sm font-semibold text-slate-800">Lo confirmamos por WhatsApp</h3>
          <p class="mt-1 text-sm leading-relaxed text-slate-500">
            Coordinamos stock, pago y entrega con vos.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
