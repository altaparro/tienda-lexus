---
import { NEGOCIO, linkWhatsApp } from '../lib/negocio'

const wa = linkWhatsApp(`Hola ${NEGOCIO.nombre}, quiero hacer una consulta.`)
const direccionQuery = encodeURIComponent(NEGOCIO.direccion)
const mapsEmbed = `https://www.google.com/maps?q=${direccionQuery}&output=embed`
const mapsLink = `https://www.google.com/maps/search/?api=1&query=${direccionQuery}`
const telLink = `tel:${NEGOCIO.telefono.replace(/[^+\d]/g, '')}`
---

<footer class="border-t border-neutral-800 bg-neutral-900">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <a href="/" class="flex items-center gap-2">
          <img src="/logo.png" alt={NEGOCIO.nombre} class="h-9 w-9 rounded-lg object-contain" />
          <span class="text-base font-bold tracking-tight text-neutral-100">{NEGOCIO.nombre}</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-neutral-400">
          Venta e instalación de estéreos, parlantes, alarmas y electricidad en {NEGOCIO.ciudad} desde 2006.
        </p>
        <a
          href={mapsLink}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 flex items-start gap-3 text-sm leading-relaxed text-neutral-400 transition hover:text-neutral-200"
        >
          <svg class="mt-0.5 h-4 w-4 shrink-0 text-orange-500" fill="none" viewBox="0 0 24 24" strokeWidth={1.8} stroke="currentColor" aria-hidden="true">
            <path strokeLinecap="round" strokeLinejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            <path strokeLinecap="round" strokeLinejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
          </svg>
          <span>{NEGOCIO.direccion}</span>
        </a>
      </div>

      <div class="space-y-8 lg:col-span-3">
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Horarios</h3>
          <p class="mt-3 text-sm leading-relaxed text-neutral-400">{NEGOCIO.horarios}</p>
        </div>
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Contacto</h3>
          <a
            href={telLink}
            class="mt-3 block text-sm text-neutral-400 transition hover:text-neutral-200"
          >
            {NEGOCIO.telefono}
          </a>
          <a
            href={wa}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-2 inline-flex items-center gap-2 text-sm font-medium text-emerald-500 transition hover:text-emerald-400"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
            </svg>
            WhatsApp
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="relative min-h-[260px] overflow-hidden rounded-2xl border border-neutral-800 bg-neutral-800">
          <iframe
            src={mapsEmbed}
            title={`Ubicación de ${NEGOCIO.nombre}`}
            class="absolute inset-0 h-full w-full"
            style="border:0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
          <a
            href={mapsLink}
            target="_blank"
            rel="noopener noreferrer"
            class="absolute bottom-3 left-3 inline-flex items-center gap-2 rounded-lg bg-neutral-950/90 px-3 py-2 text-xs font-semibold text-neutral-100 shadow-lg backdrop-blur transition hover:bg-neutral-950"
          >
            <svg class="h-4 w-4 text-orange-500" fill="none" viewBox="0 0 24 24" strokeWidth={1.8} stroke="currentColor" aria-hidden="true">
              <path strokeLinecap="round" strokeLinejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
            Cómo llegar
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-neutral-800 py-5">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-4 text-center text-xs text-neutral-500 sm:flex-row sm:text-left">
      <p>© {new Date().getFullYear()} {NEGOCIO.nombre} · Todos los derechos reservados</p>
      <p>Hecho con dedicación en {NEGOCIO.ciudad}</p>
    </div>
  </div>
</footer>
