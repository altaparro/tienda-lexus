---
import CarritoBadge from './CarritoBadge.jsx'
import { NEGOCIO } from '../lib/negocio'
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="flex items-center gap-2" aria-label={`Ir al inicio de ${NEGOCIO.nombre}`}>
      <img src="/logo.png" alt={NEGOCIO.nombre} class="h-9 w-9 rounded-lg object-contain" />
      <span class="text-sm font-bold tracking-tight text-slate-900 sm:text-base">
        {NEGOCIO.nombre}
      </span>
    </a>

    <nav class="flex items-center gap-2 sm:gap-4">
      <a
        href="/catalogo"
        class="rounded-lg px-3 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900"
      >
        Catálogo
      </a>
      <CarritoBadge client:load />
    </nav>
  </div>
</header>
