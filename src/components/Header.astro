---
import CarritoBadge from './CarritoBadge.jsx'
import { NEGOCIO } from '../lib/negocio'
---

<header class="sticky top-0 z-40 border-b border-slate-700 bg-neutral-900/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="flex items-center gap-2" aria-label={`Ir al inicio de ${NEGOCIO.nombre}`}>
      <img src="/logo.png" alt={NEGOCIO.nombre} class="h-9 w-9 rounded-lg object-contain" />
      <span class="text-sm font-bold tracking-tight text-slate-100 sm:text-base">
        {NEGOCIO.nombre}
      </span>
    </a>

    <nav class="flex items-center gap-2 sm:gap-4">
      <form action="/catalogo" method="get" class="hidden sm:block">
        <input
          type="search"
          name="q"
          placeholder="Buscar..."
          aria-label="Buscar productos"
          class="w-40 rounded-lg border border-slate-700 bg-neutral-800 px-3 py-1.5 text-sm text-slate-200 placeholder:text-slate-400 outline-none transition focus:border-orange-400 focus:bg-neutral-800 focus:ring-2 focus:ring-orange-500/30 lg:w-56"
        />
      </form>
      <a
        href="/catalogo"
        class="rounded-lg px-3 py-2 text-sm font-medium text-slate-400 transition hover:bg-neutral-700 hover:text-slate-100"
      >
        Catálogo
      </a>
      <CarritoBadge client:load />
    </nav>
  </div>
</header>
